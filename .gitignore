# Mutation-testing working tree (cargo-mutants writes its per-campaign output
# here wherever the campaign runs; regenerated every run, never committed).
mutants.out/
mutants.out.old/
dist/

# Node/Frontend
node_modules/
app/build/
app/.svelte-kit/

# Tauri (the cargo workspace target dir sits at the workspace root; the
# shell-specific artefacts live in the entropia-orme member)
app/src-tauri/target/
app/src-tauri/entropia-orme/gen/schemas/
# Build-time staging dir for the Tauri shell's bundled binaries (not source).
app/src-tauri/entropia-orme/binaries/
# Per-checkout Tauri dev config overlay generated by build-dev-config.mjs
# right before `tauri dev` runs, carrying the env-driven devUrl. Tauri 2
# has no native env-var interpolation in tauri.conf.json, so this overlay
# is how Vite's env-driven port stays in lockstep with Tauri's loaded URL.
app/src-tauri/entropia-orme/tauri.dev.local.json

# Config & secrets
.env
# Local dotenv consumed by `just`'s `set dotenv-load` to drive
# ENTROPIAORME_FRONTEND_PORT / ENTROPIAORME_DATA_DIR.
# Per-checkout; never tracked.
.env.local
# direnv activation file. Sources .env.local on `cd`-in so direct shell
# invocations honour the env without going through launch scripts.
# Per-checkout; never tracked.
.envrc
config.json
*.db
*.db-journal
*.db-wal
*.db-shm

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Runtime data (SQLite databases and generated files). data/* (not data/) so
# the directory remains walked and per-path re-inclusions work below.
data/*

# Diagnostic/temp artifacts
tmp/
/calibration/

# Local dev scratch dirs
/.scratch/
/agents/
.claude/

# WiX Burn installer: the native bafunctions DLL and its build inputs are
# produced from source by installer/burn/bafunctions/ (source + recipe tracked),
# not committed.
app/src-tauri/entropia-orme/installer/burn/bafunctions.dll
app/src-tauri/entropia-orme/installer/burn/bafunctions/.build/
