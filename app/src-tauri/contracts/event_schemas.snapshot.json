{
  "$defs": {
    "HarvestRecorded": {
      "additionalProperties": false,
      "description": "A harvesting attempt was durably recorded.",
      "properties": {
        "event_version": { "default": 1, "title": "Event Version", "type": "integer" },
        "occurred_at": { "title": "Occurred At", "type": "string" },
        "payload": { "$ref": "#/$defs/HarvestRecordedPayload" },
        "type": { "const": "harvest.recorded", "default": "harvest.recorded", "title": "Type", "type": "string" }
      },
      "required": ["occurred_at", "payload"],
      "title": "HarvestRecorded",
      "type": "object"
    },
    "HarvestRecordedPayload": {
      "additionalProperties": false,
      "description": "The durable harvest identity and whether it yielded resources.",
      "properties": {
        "harvestId": { "title": "Harvestid", "type": "string" },
        "success": { "title": "Success", "type": "boolean" }
      },
      "required": ["harvestId", "success"],
      "title": "HarvestRecordedPayload",
      "type": "object"
    },
    "HealingUpdated": {
      "additionalProperties": false,
      "description": "A session's healing evidence was corrected, or a correction undone.",
      "properties": {
        "event_version": { "default": 1, "title": "Event Version", "type": "integer" },
        "occurred_at": { "title": "Occurred At", "type": "string" },
        "payload": { "$ref": "#/$defs/HealingUpdatedPayload" },
        "type": { "const": "healing.updated", "default": "healing.updated", "title": "Type", "type": "string" }
      },
      "required": ["occurred_at", "payload"],
      "title": "HealingUpdated",
      "type": "object"
    },
    "HealingUpdatedPayload": {
      "additionalProperties": false,
      "description": "A content-free invalidation that prompts consumers to re-read heal costs and healing evidence.",
      "properties": {},
      "required": [],
      "title": "HealingUpdatedPayload",
      "type": "object"
    },
    "NavigationUpdated": {
      "additionalProperties": false,
      "description": "The persisted navigation run changed.",
      "properties": {
        "event_version": { "default": 1, "title": "Event Version", "type": "integer" },
        "occurred_at": { "title": "Occurred At", "type": "string" },
        "payload": { "$ref": "#/$defs/NavigationUpdatedPayload" },
        "type": { "const": "navigation.updated", "default": "navigation.updated", "title": "Type", "type": "string" }
      },
      "required": ["occurred_at", "payload"],
      "title": "NavigationUpdated",
      "type": "object"
    },
    "NavigationUpdatedPayload": {
      "additionalProperties": false,
      "description": "A content-free invalidation that prompts consumers to hydrate navigation state.",
      "properties": {},
      "required": [],
      "title": "NavigationUpdatedPayload",
      "type": "object"
    },
    "ProtectionUpdated": {
      "additionalProperties": false,
      "description": "A protection cost was recorded or undone, or a limited set changed.",
      "properties": {
        "event_version": { "default": 1, "title": "Event Version", "type": "integer" },
        "occurred_at": { "title": "Occurred At", "type": "string" },
        "payload": { "$ref": "#/$defs/ProtectionUpdatedPayload" },
        "type": { "const": "protection.updated", "default": "protection.updated", "title": "Type", "type": "string" }
      },
      "required": ["occurred_at", "payload"],
      "title": "ProtectionUpdated",
      "type": "object"
    },
    "ProtectionUpdatedPayload": {
      "additionalProperties": false,
      "description": "A content-free invalidation that prompts consumers to re-read armour costs.",
      "properties": {},
      "required": [],
      "title": "ProtectionUpdatedPayload",
      "type": "object"
    },
    "ScanStatusChanged": {
      "additionalProperties": false,
      "description": "The manual skill-scan status changed (phase transition or capture/OCR progress).",
      "properties": {
        "event_version": {
          "default": 1,
          "title": "Event Version",
          "type": "integer"
        },
        "occurred_at": {
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ScanStatusChangedPayload"
        },
        "type": {
          "const": "scan.status.changed",
          "default": "scan.status.changed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "occurred_at",
        "payload"
      ],
      "title": "ScanStatusChanged",
      "type": "object"
    },
    "ScanStatusChangedPayload": {
      "additionalProperties": false,
      "description": "Push-to-pull invalidation signal for the manual skill-scan flow.\n\nCarries only the coarse phase so a listener can route (and a human can read\nthe wire). The window re-hydrates the full status via the scan-status GET on\nevery frame, so per-page capture/OCR progress liveness comes from the\nhydration rather than from widening this payload: the emitter still fires on\nevery discrete progress change (see ``SkillScanManual``), but the wire stays\na minimal invalidation signal.",
      "properties": {
        "phase": {
          "enum": [
            "idle",
            "capturing",
            "processing",
            "awaiting_review"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "phase"
      ],
      "title": "ScanStatusChangedPayload",
      "type": "object"
    },
    "TrackingSessionUpdated": {
      "additionalProperties": false,
      "description": "The session aggregates changed (started, advanced a tick, or stopped).",
      "properties": {
        "event_version": {
          "default": 1,
          "title": "Event Version",
          "type": "integer"
        },
        "occurred_at": {
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TrackingSessionUpdatedPayload"
        },
        "type": {
          "const": "tracking.session.updated",
          "default": "tracking.session.updated",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "occurred_at",
        "payload"
      ],
      "title": "TrackingSessionUpdated",
      "type": "object"
    },
    "TrackingSessionUpdatedPayload": {
      "additionalProperties": false,
      "description": "Push-to-pull invalidation signal for the live tracking session.\n\nCarries only what the frontend needs to route the change: which session, the\ncoarse active/idle state (so a subscriber can route on it without parsing the\nbody), and why it fired. The window re-hydrates the full readout via the\nsnapshot GET.",
      "properties": {
        "reason": {
          "enum": [
            "started",
            "updated",
            "stopped"
          ],
          "title": "Reason",
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        },
        "status": {
          "enum": [
            "active",
            "idle"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "TrackingSessionUpdatedPayload",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "harvest.recorded": "#/$defs/HarvestRecorded",
      "healing.updated": "#/$defs/HealingUpdated",
      "navigation.updated": "#/$defs/NavigationUpdated",
      "protection.updated": "#/$defs/ProtectionUpdated",
      "scan.status.changed": "#/$defs/ScanStatusChanged",
      "tracking.session.updated": "#/$defs/TrackingSessionUpdated"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TrackingSessionUpdated"
    },
    {
      "$ref": "#/$defs/ScanStatusChanged"
    },
    {
      "$ref": "#/$defs/HarvestRecorded"
    },
    {
      "$ref": "#/$defs/NavigationUpdated"
    },
    {
      "$ref": "#/$defs/ProtectionUpdated"
    },
    {
      "$ref": "#/$defs/HealingUpdated"
    }
  ]
}
